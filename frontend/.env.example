# Solo compilación de demostración local. El backend valida su propio permiso.
VITE_GEO_SIMULATOR=true
VITE_GEO_INTERVAL_MS=4000
# Opcional: estilo MapLibre completo, o fuente raster y atribución correspondientes.
# VITE_MAP_STYLE_URL=https://proveedor.example/style.json
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=© OpenStreetMap contributors
