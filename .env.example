COMPOSE_PROJECT_NAME=flashdelivery
MINISTACK_IMAGE=ministackorg/ministack:1.5.36
REDIS_IMAGE=redis:7.4.2-alpine
MINISTACK_PORT=4566
REDIS_PORT=6379
AWS_ENDPOINT_URL=http://127.0.0.1:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_EC2_METADATA_DISABLED=true
ENVIRONMENT=local
DYNAMODB_TABLE_NAME=FlashDeliveryTable
REDIS_HOST=127.0.0.1
CONNECT_TIMEOUT=2
READ_TIMEOUT=5
