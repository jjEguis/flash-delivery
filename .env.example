COMPOSE_PROJECT_NAME=flashdelivery
MINISTACK_IMAGE=ministackorg/ministack:1.5.36
REDIS_IMAGE=redis:7.4.2-alpine
MINISTACK_PORT=4566
REDIS_PORT=6379
AWS_ENDPOINT_URL=http://127.0.0.1:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_EC2_METADATA_DISABLED=true
ENVIRONMENT=local
DYNAMODB_TABLE_NAME=FlashDeliveryTable
REDIS_HOST=127.0.0.1
CONNECT_TIMEOUT=2
READ_TIMEOUT=5
# GEO v2: preparación explícita; no se publica el puerto de OSRM.
OSRM_IMAGE=ghcr.io/project-osrm/osrm-backend:v5.27.1
OSRM_URL=http://osrm:5000
OSRM_TIMEOUT_SECONDS=3
OSRM_HEALTH_TIMEOUT=5s
OSM_PBF_URL=https://download.geofabrik.de/south-america/colombia-latest.osm.pbf
ROUTING_BBOX=-74.28,11.12,-74.05,11.36
TRACKING_SIMULATION_ENABLED=true
LOCATION_TTL_SECONDS=120
LOCATION_FRESH_SECONDS=15
LOCATION_MIN_INTERVAL_MS=3000
ROUTE_TTL_SECONDS=300
ROUTE_DEVIATION_METERS=50
ROUTE_RECALCULATE_SECONDS=30
